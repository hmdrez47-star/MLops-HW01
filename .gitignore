# ---- syntax / packaging -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ---- virtual environments ----------------------------------------------
venv/
.venv/
env/

# ---- IDE / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- data --------------------------------------------------------------
# The two reference datasets are tiny (~50 KB) and required to run the
# pipeline, the tests and the drift check, so they are tracked here and
# identified by the SHA-256 hashes in data_versions/metadata.json.
# Frozen snapshots and processed output are regenerated, so they stay out.
data/processed/*
!data/processed/.gitkeep
data_versions/*.csv

# ---- model artifacts ---------------------------------------------------
# The served artifact is under 5 KB and is part of the submission, so it is
# tracked; models/metadata.json records the data version, metric and git commit
# needed to rebuild it byte-for-byte.
!models/.gitkeep

# ---- experiment output -------------------------------------------------
mlruns/
mlflow.db
mlflow.db-*
experiments/logs/*
!experiments/logs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep

# ---- generated reports -------------------------------------------------
reports/*.json
reports/*.md
!reports/.gitkeep

# ---- secrets -----------------------------------------------------------
.env
.env.*
secrets/
*.pem
*.key
